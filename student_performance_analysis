        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "from sklearn.model_selection import StratifiedKFold, cross_val_score\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.preprocessing import OneHotEncoder, StandardScaler\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.dummy import DummyClassifier\n",
        "\n",
        "#Define target and features\n",
        "target_col = \"Passed Final Grade\"\n",
        "\n",
        "feature_cols = [\n",
        "    \"Weekly Study Time\",\n",
        "    \"Past Class Failures\",\n",
        "    \"School Absences\",\n",
        "    \"Family Support\"\n",
        "]\n",
        "\n",
        "data = students[feature_cols + [target_col]].copy()\n",
        "\n",
        "#Ensure target is binary (0/1)\n",
        "if data[target_col].dtype == \"object\":\n",
        "    data[target_col] = (\n",
        "        data[target_col]\n",
        "        .astype(str).str.strip().str.lower()\n",
        "        .map({\n",
        "            \"yes\": 1, \"no\": 0,\n",
        "            \"pass\": 1, \"fail\": 0,\n",
        "            \"true\": 1, \"false\": 0,\n",
        "            \"1\": 1, \"0\": 0\n",
        "        })\n",
        "    )\n",
        "\n",
        "data = data.dropna(subset=[target_col])\n",
        "\n",
        "X = data[feature_cols]\n",
        "y = data[target_col].astype(int)\n",
        "\n",
        "\n",
        "#Preprocessing\n",
        "numeric_features = [\n",
        "    \"Weekly Study Time\",\n",
        "    \"Past Class Failures\",\n",
        "    \"School Absences\"\n",
        "]\n",
        "\n",
        "categorical_features = [\"Family Support\"]\n",
        "\n",
        "preprocessor = ColumnTransformer(\n",
        "    transformers=[\n",
        "        (\"num\", StandardScaler(), numeric_features),\n",
        "        (\"cat\", OneHotEncoder(drop=\"if_binary\", handle_unknown=\"ignore\"), categorical_features)\n",
        "    ]\n",
        ")\n",
        "\n",
        "#Used AI to help generate Logistic Model & Cross Validation in this section\n",
        "#Logistic Regression model\n",
        "logistic_model = Pipeline(steps=[\n",
        "    (\"preprocess\", preprocessor),\n",
        "    (\"classifier\", LogisticRegression(max_iter=1000))\n",
        "])\n",
        "\n",
        "#Cross-validation\n",
        "cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
        "\n",
        "logistic_scores = cross_val_score(\n",
        "    logistic_model, X, y, cv=cv, scoring=\"accuracy\"\n",
        ")\n",
        "\n",
        "print(\"Logistic Regression accuracy scores:\", logistic_scores)\n",
        "print(f\"Mean accuracy: {logistic_scores.mean():.3f}\")\n",
        "print(f\"Standard deviation: {logistic_scores.std():.3f}\")\n",
        "\n",
        "#Dummy baseline\n",
        "dummy_model = Pipeline(steps=[\n",
        "    (\"preprocess\", preprocessor),\n",
        "    (\"classifier\", DummyClassifier(strategy=\"most_frequent\"))\n",
        "])\n",
        "\n",
        "dummy_scores = cross_val_score(\n",
        "    dummy_model, X, y, cv=cv, scoring=\"accuracy\"\n",
        ")\n",
        "\n",
        "print(\"\\nDummy classifier accuracy scores:\", dummy_scores)\n",
        "print(f\"Dummy mean accuracy: {dummy_scores.mean():.3f}\")"
