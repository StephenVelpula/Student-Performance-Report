    {
      "cell_type": "code",
      "source": [
        "#Safe copy\n",
        "students = df_math.copy()\n",
        "\n",
        "#Identify text/categorical columns\n",
        "obj_cols = students.select_dtypes(include=[\"object\"]).columns\n",
